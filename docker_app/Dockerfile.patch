# Patch package: reuse the installed browser/media runtime from v11.3.
# The resulting docker-save archive includes its base layers and loads alone.
ARG PATCH_BASE_IMAGE=zzs-bili-gallery:11.3-amd64
FROM ${PATCH_BASE_IMAGE}
COPY docker_app /opt/zzs/docker_app
COPY bili_9pics_downloader.py /workspace/bili_9pics_downloader.py
COPY LivePhoto /workspace/LivePhoto
