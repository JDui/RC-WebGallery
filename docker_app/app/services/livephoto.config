# Embedded XMP identifier read by an unconfigured ExifTool as ContentIdentifier.
# This is Immich-compatible grouping, not an Apple Photos capture format.
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        rcgallery => { SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::rcgallery' } },
    },
    # Debian bookworm's ExifTool predates the built-in name for this key.
    'Image::ExifTool::QuickTime::Keys' => {
        'content.identifier' => { Name => 'ContentIdentifier', Writable => 'string' },
    },
);
%Image::ExifTool::UserDefined::rcgallery = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-rcgallery', 2 => 'Image' },
    NAMESPACE => { rcgallery => 'urn:rc-webgallery:livephoto:1.0' },
    WRITABLE => 'string',
    ContentIdentifier => {},
);
1;
